{
    "name": "critterhub",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "oxlint --config ./oxlint.config.js .",
        "lint:fix": "oxlint --config ./oxlint.config.js . --fix",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "validate": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build && npm audit",
        "prepare": "husky",
        "fix": "prettier . --write && oxlint --config ./oxlint.config.js . --fix",
        "check": "prettier --check && oxlint --config ./oxlint.config.js .",
        "verify": "prettier . --check && oxlint --config ./oxlint.config.js . && vite build"
    },
    "lint-staged": {
        "*.{js,jsx}": [
            "prettier --write",
            "oxlint --config ./oxlint.config.js"
        ],
        "*.{scss,css}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@hookform/resolvers": "^5.9.1",
        "@tailwindcss/vite": "^4.3.3",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "lucide-react": "^1.48.0",
        "nanoid": "^6.0.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.18.4",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "zod": "^3.25.76",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@types/node": "^26.6.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "husky": "^9.1.7",
        "jsdom": "^30.1.1",
        "lint-staged": "^17.6.0",
        "oxlint": "^1.81.0",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "vite": "^8.3.0",
        "vitest": "^5.0.2"
    }
}
